{"e":{"at":374155,"causedBy":[35],"gen":"g1","payload":{"delta":"Ocean tides come mostly from the Moon's gravity. The Moon pulls harder on the side of Earth facing it than on Earth's center, and harder on the center than on the far side. That difference in pull, called the tidal force, stretches the oceans into two bulges. One faces the Moon. The other sits on the opposite side, where the water is pulled less than the Earth beneath it and gets \"left behind.\"\n\n","final":false,"index":0,"msgKey":"m1"},"provenance":{"confirmed":true,"sources":["hook"]},"seq":19,"sessionKey":"sc9d59a04","turnKey":"t1","type":"assistant.textDelta","v":1,"wallAt":0},"r":"event"}
